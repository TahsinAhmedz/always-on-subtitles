{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Always On Subtitles",
  "version": "0.1.0",
  "identifier": "com.alwaysonsubtitles.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "caption",
        "title": "Always On Subtitles",
        "url": "index.html?label=caption",
        "width": 800,
        "height": 200,
        "x": 100,
        "y": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Always On Subtitles — Settings",
        "url": "index.html?label=settings",
        "width": 620,
        "height": 720,
        "center": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Floating always-on-top YouTube subtitles",
    "longDescription": "A companion app that shows YouTube subtitles in a floating always-on-top window, visible even when you're not in the browser."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
